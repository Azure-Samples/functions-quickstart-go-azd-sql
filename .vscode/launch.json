{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Go Functions",
      "type": "go",
      "request": "attach",
      "mode": "local",
      "processId": "${command:pickGoProcess}",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "func: host start",
      "showLog": true
    }
  ]
}
